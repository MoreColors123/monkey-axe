# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# ...but the shipped game jar is committed on purpose (double-click Play.bat)
!monkeyaxe.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ignore anything named dist/ and below
dist/

# local no-Ant build output (created by run.ps1)
build-custom/
# release build scratch (make_release.ps1)
build-release/

# generated sprite detection preview
JavaGoldenAxe/tools/guybrush/sprites_overview.png

# Windows Explorer "copy" duplicates (e.g. "mapping - Kopie.json")
* - Kopie.*

# reviewer export backup + temp file (written next to mapping.json)
JavaGoldenAxe/tools/guybrush/mapping.backup.json
JavaGoldenAxe/tools/guybrush/mapping.json.tmp
JavaGoldenAxe/tools/guybrush/sprites.backup.json
JavaGoldenAxe/tools/guybrush/__pycache__/

# Ant/NetBeans build output (rebuilt locally; the shipped jar comes from make_release.ps1)
JavaGoldenAxe/build/
JavaGoldenAxeAnimationEditor2/build/

# NetBeans per-user state (machine-local paths, regenerated on open)
*/nbproject/private/
